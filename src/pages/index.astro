---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="page">
		<main>
			<h1 class="visually-hidden">Tarjni Jotaniya</h1>
			<section class="intro">
				<div class="badge">
					<svg class="badge-ring" width="280" height="280" viewBox="0 0 150 150" aria-hidden="true">
						<defs>
							<path id="badge-circle" d="M 75,75 m -60,0 a 60,60 0 1,1 120,0 a 60,60 0 1,1 -120,0"></path>
						</defs>
						<text>
							<textPath href="#badge-circle" textLength="377" lengthAdjust="spacing"
								>TARJNI JOTANIYA · TARJNI JOTANIYA ·&nbsp;</textPath
							>
						</text>
					</svg>
					<span class="badge-emoji" role="img" aria-label="pointing up">☝️</span>
				</div>
				<div class="intro-text">
					<p>
						Tarjni is a multidisciplinary designer and strategist exploring how technology transforms
						human relationships. Through purposeful storytelling and deep inquiry, she grounds complex
						ideas into thoughtful, intuitive experiences.
					</p>
					<p class="intro-note">Currently building agentic workflows at Klaviyo, previously at Meta.</p>
				</div>
			</section>
		</main>
		<footer>tarjni©2026</footer>
	</div>
</Layout>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	.page {
		box-sizing: border-box;
		min-height: 100%;
		padding: 2rem 1rem 1rem;
		display: flex;
		flex-direction: column;
	}

	main {
		flex: 1;
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding-block: clamp(2rem, 8vh, 6rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	p {
		margin: 0;
	}

	.intro {
		--badge-size: clamp(180px, 22vw, 280px);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 3rem;
	}

	.badge {
		position: relative;
		flex-shrink: 0;
		width: var(--badge-size);
		height: var(--badge-size);
	}

	.badge-ring {
		display: block;
		width: 100%;
		height: 100%;
		animation: badge-spin 25s linear infinite;
	}

	.badge-ring text {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 11px;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		fill: currentColor;
	}

	.badge-emoji {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		font-size: calc(var(--badge-size) / 3);
		line-height: 1;
	}

	.intro-text p {
		font-size: clamp(1.25rem, 1rem + 1.1vw, 1.75rem);
		line-height: 1.5;
	}

	.intro-text .intro-note {
		margin-top: 0.75rem;
		font-size: 1.15rem;
		color: #595959;
	}

	@keyframes badge-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.badge-ring {
			animation: none;
		}
	}

	@media (max-width: 767px) {
		.intro {
			flex-direction: column;
			gap: 2rem;
		}
	}

	footer {
		align-self: flex-end;
		margin-top: 2rem;
		font-size: 0.75rem;
		color: #6b6b6b;
	}
</style>
