---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<h1>Hello! 👋 I'm Tarjni</h1>
		<p>
			NY-Based Researcher &amp; strategist with experience leading foundational, qualitative, and
			mixed-methods research that shapes product vision and strategy 6–12 months ahead.
		</p>
		<p>
			I enjoy using research and design to understand how technology shapes the way people live,
			work, and connect, and turn complex ideas into tangible experiences. 🌏
		</p>
	</main>
</Layout>

<style>
	main {
		box-sizing: border-box;
		max-width: 40rem;
		min-height: 100%;
		margin: 0 auto;
		padding: 2rem 1rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		text-align: center;
	}

	h1 {
		margin: 0 0 1rem;
		font-size: clamp(2rem, 6vw, 3rem);
		line-height: 1.1;
	}

	p {
		margin: 0;
		font-size: 1.125rem;
		line-height: 1.6;
	}

	p + p {
		margin-top: 1.5rem;
	}
</style>
