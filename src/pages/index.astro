---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<h1>Tarjni Jotaniya</h1>
		<p>
			NY-based experience designer, researcher, and strategist creating frictionless
			human-centered experiences; Previously at Meta and Klaviyo.
		</p>
	</main>
</Layout>

<style>
	main {
		box-sizing: border-box;
		max-width: 40rem;
		min-height: 100%;
		margin: 0 auto;
		padding: 2rem 1rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	h1 {
		margin: 0 0 1rem;
		font-size: clamp(2rem, 6vw, 3rem);
		line-height: 1.1;
	}

	p {
		margin: 0;
		font-size: 1.125rem;
		line-height: 1.6;
	}
</style>
